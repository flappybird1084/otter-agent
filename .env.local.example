# Synapse / otter-agent — local env template
# Copy to .env.local and fill in.

# Required: Google AI Studio API key → https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Optional: model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Required: session cookie signing key. Rotate before deploy.
JWT_SECRET=dev-only-secret-change-me

# Optional: shows quick-login buttons for alice/bob/carol/dave on /login.
DEMO_MODE=true

# Optional: Telegram bot for inbound chat with your agent (step 6).
TELEGRAM_BOT_TOKEN=

# Legacy / unused
ANTHROPIC_API_KEY=
