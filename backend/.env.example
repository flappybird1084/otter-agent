# Backend selection: "local" (JSON-on-disk, no GCP needed) or "firestore"
STORE_BACKEND=local
LOCAL_STORE_PATH=./local_store.json
LOCAL_NOTES_PATH=./seed/notes

# LLM backend: "vertex" (Gemini via Vertex AI) or "mock" (scripted demo replay)
LLM_BACKEND=mock

# Vertex AI (used when LLM_BACKEND=vertex and/or STORE_BACKEND=firestore)
GCP_PROJECT_ID=your-project-id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Cloud Storage (used when STORE_BACKEND=firestore)
GCS_BUCKET=your-bucket

# Server
PORT=8080

# Telegram bridge (optional)
# When set, the backend connects to Telegram on startup. The agent can then
# call ask_user / confirm_action and the user receives the prompt as a chat
# message with inline buttons. Get a token from @BotFather. Leave blank to
# disable — the tools will return a graceful "no telegram link" result.
TELEGRAM_BOT_TOKEN=
