# Backend selection: "local" (JSON-on-disk, no GCP needed) or "firestore"
STORE_BACKEND=local
LOCAL_STORE_PATH=./local_store.json
LOCAL_NOTES_PATH=./seed/notes

# LLM backend: "vertex" (Gemini via Vertex AI) or "mock" (scripted demo replay)
LLM_BACKEND=mock

# Vertex AI (used when LLM_BACKEND=vertex and/or STORE_BACKEND=firestore)
GCP_PROJECT_ID=your-project-id
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Cloud Storage (used when STORE_BACKEND=firestore)
GCS_BUCKET=your-bucket

# Server
PORT=8080

# ActionLayer (task delegation) — optional. When set, the agent gains
# action_* tools and can delegate real-world actions (sending emails,
# filling forms, booking things) by describing a goal in plain English.
# Get a key at https://actionlayer.io/app → Settings → API Keys.
# When unset, the action_* tools return actionlayer_disabled and the
# agent is instructed not to claim the action happened.
ACTIONLAYER_API_KEY=
ACTIONLAYER_BASE_URL=https://api.actionlayer.io
